{
  "manifest_version": 3,
  "name": "Sushi — fill this application",
  "version": "1.0.0",
  "description": "Puts Sushi's Fill button on job pages you are already reading, and hands the job to the app when you press it.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["host.js", "bubble.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
